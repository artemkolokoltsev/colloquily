# Langtrace self-hosted stack
LANGTRACE_NEXTAUTH_SECRET=change-me-langtrace-secret
LANGTRACE_ADMIN_EMAIL=admin@local.langtrace
LANGTRACE_ADMIN_PASSWORD=change-me-admin-password
LANGTRACE_ENABLE_ADMIN_LOGIN=true
LANGTRACE_PUBLIC_HOST=http://localhost:3000

LANGTRACE_POSTGRES_DB=langtrace
LANGTRACE_POSTGRES_USER=ltuser
LANGTRACE_POSTGRES_PASSWORD=ltpassword

LANGTRACE_CLICKHOUSE_DB=langtrace
LANGTRACE_CLICKHOUSE_USER=langtrace
LANGTRACE_CLICKHOUSE_PASSWORD=change-me-clickhouse-password

# Python app tracing
LANGTRACE_ENABLED=true
LANGTRACE_MODE=self_hosted
LANGTRACE_API_HOST=http://localhost:3000/api/trace
LANGTRACE_API_KEY=
LANGTRACE_BATCH=true
LANGTRACE_WRITE_SPANS_TO_CONSOLE=false
LANGTRACE_CAPTURE_CONTENT=true

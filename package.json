{
  "name": "colloquily",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i meditech_rag/assets/app.css -o meditech_rag/static/tailwind.css --minify",
    "build:js": "esbuild meditech_rag/assets/app.js --bundle --minify --outfile=meditech_rag/static/app.bundle.js",
    "build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "watch:css": "tailwindcss -i meditech_rag/assets/app.css -o meditech_rag/static/tailwind.css --watch",
    "build:legacy": "npm run build:css && npm run build:js",
    "dev": "vite --config frontend/vite.config.ts",
    "dev:backend": "python -m backend.launcher --port 8765",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:dev:backend\"",
    "tauri": "tauri",
    "build:sidecar": "python scripts/build_sidecar.py",
    "test:api": "python -m unittest discover -s backend/tests -v"
    ,"test:translations": "node scripts/check_translations.mjs"
    ,"test": "npm run test:translations"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "esbuild": "0.28.2",
    "prettier": "^3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "alpinejs": "3.16.3",
    "i18next": "^26.4.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide": "1.34.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.16"
  }
}

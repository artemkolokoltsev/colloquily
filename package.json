{
  "name": "colloquily",
  "version": "0.1.10",
  "private": true,
  "license": "Apache-2.0",
  "description": "Local-first, source-grounded oral exam preparation for university students",
  "homepage": "https://github.com/artemkolokoltsev/colloquily#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/artemkolokoltsev/colloquily.git"
  },
  "scripts": {
    "build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "dev": "vite --config frontend/vite.config.ts",
    "dev:backend": "python -m backend.launcher --port 8765",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:dev:backend\"",
    "tauri": "tauri",
    "build:sidecar": "python scripts/build_sidecar.py",
    "test:api": "python -m unittest discover -s backend/tests -v",
    "test:translations": "node scripts/check_translations.mjs",
    "test": "node scripts/check_version.mjs && npm run test:translations && npm run test:frontend",
    "test:frontend": "node --experimental-strip-types --test tests/frontend/*.test.mjs",
    "test:pdf": "npm run build && node scripts/smoke_pdf_reader.mjs",
    "lint": "python scripts/check_quality.py lint",
    "format-check": "python scripts/check_quality.py format",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "test:quality": "python -m unittest discover -s tests/tooling -v"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.72.1",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  }
}
